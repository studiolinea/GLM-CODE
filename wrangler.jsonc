// Mise en ligne sur Cloudflare : les pages de l'appli (dossier dist/) et le petit serveur (src/serveur/worker.ts).
// Le nom doit être le même que le « Nom du projet » choisi dans Cloudflare.
{
  "name": "pilotage",
  "main": "src/serveur/worker.ts",
  "compatibility_date": "2026-10-01",
  // L'adresse publique pilotage.<sous-domaine>.workers.dev reste activée à chaque mise en ligne.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Seules les adresses /api/… passent par le serveur ; les pages sont servies directement.
    "run_worker_first": ["/api/*"]
  },
  // Valeurs publiques. Le secret CLE_CHIFFREMENT se pose dans les réglages Cloudflare, jamais ici.
  "vars": {
    "SUPABASE_URL": "https://onzisrzwlzbhtvmzuwrf.supabase.co",
    "SUPABASE_CLE_PUBLIQUE": "sb_publishable_F-Q33yhg8WU3uNDjKtnfvw_51OfqJnz"
  }
}
