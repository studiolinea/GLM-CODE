// Mise en ligne sur Cloudflare (Workers, fichiers statiques).
// Le nom doit être le même que le « Nom du projet » choisi dans Cloudflare.
{
  "name": "pilotage",
  "compatibility_date": "2026-10-01",
  // L'adresse publique pilotage.<sous-domaine>.workers.dev reste activée à chaque mise en ligne.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
